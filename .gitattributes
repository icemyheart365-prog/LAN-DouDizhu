# Linux、Windows 互调不用 .gitattributes，亲人两行泪。
# Default: normalize text files to LF in the repository
* text=auto

# Explicit text formats
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.exe  binary
*.dll  binary
